{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-pr-create.sh",
            "onFailure": "block",
            "timeout": 30,
            "statusMessage": "PR の内容を検査しています..."
          }
        ]
      }
    ]
  }
}

# Internal Notion connection token; grant read access to the database itself.
NOTION_TOKEN=
# Database ID from its full-page URL, before ?v= (NOT a data source/view ID).
NOTION_DATABASE_ID=
# Exact, case-sensitive Status/select option used to publish a page.
NOTION_PUBLISHED_VALUE=Done
# Canonical public URL. Change when you connect a custom domain.
SITE_URL=https://blume-blog.vercel.app
